# API base URL, including the version prefix.
VITE_API_BASE_URL=http://localhost:8000/v1

# WebSocket endpoint for the rates stream.
VITE_WS_URL=ws://localhost:8000/v1/ws/rates

# Serve the app from MSW fixtures instead of a live backend.
VITE_USE_MOCK_API=true

# Comma-separated symbol list. Defaults are used when this is empty.
VITE_DEFAULT_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,BTC/USDT,ETH/USDT

# Default chart interval: 1m, 5m, or 1h.
VITE_DEFAULT_INTERVAL=1m
